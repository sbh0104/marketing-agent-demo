# 비밀 값 — 실제 키는 .env 에만 둡니다. .env.example 만 커밋합니다.
.env
.env.*
!.env.example
.envrc
.env-local
# OAuth 클라이언트 비밀 · 토큰 파일
client_secret_*.json
token.json

# 회사 과제 안내 PDF — 공개하지 않습니다 (트래커 Phase 8)
docs/marketing-agent.pdf

# 크롬 전용 프로필 — chrome-profile/ 또는 저장소 밖에만 둡니다 (계약 8절)
chrome-profile/
# 크롬 프로필 안의 비밀 파일 — 위치 규칙을 어겼을 때의 둘째 방어, 프로필 폴더 이름과 상관없이 막습니다
Cookies
Cookies-journal
Login Data*
Web Data*
Local State
Local Storage/
Session Storage/
Preferences
Secure Preferences
History*
IndexedDB/
Sessions/
Extension Cookies
Account Web Data
# 쿠키 · Playwright 로그인 상태 내보내기
cookies*.json
*storage_state*.json

# 실행 중 생기는 파일 — 폴더만 커밋, logs/sample.log 는 제출물이라 커밋
data/*
!data/.gitkeep
logs/*
!logs/.gitkeep
!logs/sample.log

# Python
__pycache__/
*.py[cod]
.venv/
