# 비밀 값 — 실제 키는 .env 에만 둡니다. .env.example 만 커밋합니다.
.env
.env.*
!.env.example

# 크롬 전용 프로필 — 권장 위치는 chrome-profile/ (Phase 6 이 정합니다)
chrome-profile/
# 크롬 프로필 안의 비밀 파일 — 프로필 폴더 이름과 상관없이 막습니다
Cookies
Cookies-journal
Login Data*
Web Data*
Local State
Local Storage/
Session Storage/
# 쿠키 · Playwright 로그인 상태 내보내기
cookies*.json
*storage_state*.json

# 실행 중 생기는 파일 — 폴더만 커밋, logs/sample.log 는 제출물이라 커밋
data/*
!data/.gitkeep
logs/*
!logs/.gitkeep
!logs/sample.log

# Python
__pycache__/
*.py[cod]
.venv/
